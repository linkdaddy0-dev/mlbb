# Release signing credentials. NEVER commit this file — it is gitignored.
#
# IMPORTANT: if MythicIQ is ALREADY published on Google Play, do NOT use the
# generated mythiciq-release.jks. Play permanently binds a listing to its
# upload key; a different key is rejected. Point storeFile/keyAlias/passwords
# at your EXISTING keystore instead.
#
# storeFile is resolved relative to the android/ directory.
storeFile=mythiciq-release.jks
storePassword=CHANGE_ME
keyAlias=mythiciq
keyPassword=CHANGE_ME
